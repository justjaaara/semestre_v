  <folder name="Application" id="id-6ba13dbf7587435fa95b7c26805ba188" type="application">
    <element xsi:type="archimate:ApplicationComponent" name="Sistema de reservas" id="id-51013ad23d7145d38adc59772a989331">
      <documentation>Representa el software que gestiona las reservas de vuelos.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="CRM" id="id-32195d868a9b4f2294dafe60616606ed">
      <documentation>Sistema de gestión de relaciones con clientes. Permite segmentación, historial de compras y personalización de ofertas.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Sistema de gestión de reservas" id="id-b55a2b10f51e44e0b84684a1912c65ac">
      <documentation>Maneja la disponibilidad de vuelos, generación de itinerarios y confirmaciones de compra.&#xD;
&#xD;
</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Application Component" id="id-67af4c0ba10b41679e587f2ae2117263"/>
    <element xsi:type="archimate:ApplicationComponent" name="Sistema de notificaciones" id="id-064fe555bb044911be1605079c4da45b">
      <documentation>Informa a los clientes sobre cambios en sus vuelos o itinerarios.&#xD;
&#xD;
</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Sistema de gestión de reprogramaciones" id="id-0820e85be17444378551de0e0734db72">
      <documentation>Facilita la reubicación de pasajeros en vuelos alternativos y gestiona compensaciones.&#xD;
&#xD;
</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Plataforma de promociones" id="id-eebc9226a82e4823b3ea48ab9909bd41">
      <documentation>Sistema encargado de gestionar promociones y descuentos para los clientes.&#xD;
&#xD;
</documentation>
    </element>
